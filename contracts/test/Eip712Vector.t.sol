pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";

import {SafeCast} from "@openzeppelin/contracts/utils/math/SafeCast.sol";

import {PaymentRegistry} from "../src/PaymentRegistry.sol";
import {
    PAYMENT_INTENT_TYPEHASH,
    REVOCATION_TYPEHASH,
    VERIFICATION_ATTESTATION_TYPEHASH,
    PaymentIntent,
    Revocation,
    RevocationReason,
    Status,
    Tier,
    VerificationAttestation,
    VerificationMethod,
    VerificationResult
} from "../src/SyloTypes.sol";

/// @notice The shared EIP-712 vector. `spec/eip712.json` is generated by `python -m sylo_spec.eip712` and the
/// Python tests assert against the same file: if a test here fails, Solidity and Python no longer hash alike and
/// no signature made off-chain would be accepted on-chain.
///
/// The vector's domain uses `verifyingContract = 0x…01`, an address no contract can live at, so the digests are
/// rebuilt here from the domain fields with the EIP-712 formula. The same formula is then checked against the
/// registry's own domain, which ties `PaymentRegistry.digestOf` to the vector.
contract Eip712VectorTest is Test {
    string internal constant VECTOR_PATH = "../spec/eip712.json";

    bytes32 internal constant EIP712_DOMAIN_TYPEHASH =
        keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");

    PaymentRegistry internal registry;
    string internal json;

    function setUp() public {
        registry = new PaymentRegistry(address(this));
        json = vm.readFile(VECTOR_PATH);
    }

    // ------------------------------------------------------------------ types and enumerations

    function test_TypeHashes_MatchTheVector() public view {
        assertEq(PAYMENT_INTENT_TYPEHASH, _bytes32(".typeHashes.PaymentIntent"), "PaymentIntent typehash");
        assertEq(
            VERIFICATION_ATTESTATION_TYPEHASH,
            _bytes32(".typeHashes.VerificationAttestation"),
            "VerificationAttestation typehash"
        );
        assertEq(REVOCATION_TYPEHASH, _bytes32(".typeHashes.Revocation"), "Revocation typehash");
    }

    function test_TypeHashes_AreTheHashesOfTheTypeStrings() public view {
        assertEq(PAYMENT_INTENT_TYPEHASH, keccak256(bytes(_string(".types.PaymentIntent"))), "PaymentIntent");
        assertEq(
            VERIFICATION_ATTESTATION_TYPEHASH,
            keccak256(bytes(_string(".types.VerificationAttestation"))),
            "VerificationAttestation"
        );
        assertEq(REVOCATION_TYPEHASH, keccak256(bytes(_string(".types.Revocation"))), "Revocation");
    }

    function test_Enums_HaveTheNumbersOfTheVector() public view {
        assertEq(uint256(Tier.LOW), _uint(".enums.Tier.LOW"));
        assertEq(uint256(Tier.MEDIUM), _uint(".enums.Tier.MEDIUM"));
        assertEq(uint256(Tier.HIGH), _uint(".enums.Tier.HIGH"));
        assertEq(uint256(Tier.CRITICAL), _uint(".enums.Tier.CRITICAL"));

        assertEq(uint256(Status.NONE), _uint(".enums.Status.NONE"));
        assertEq(uint256(Status.COMMITTED), _uint(".enums.Status.COMMITTED"));
        assertEq(uint256(Status.CONFIRMED), _uint(".enums.Status.CONFIRMED"));
        assertEq(uint256(Status.DENIED), _uint(".enums.Status.DENIED"));
        assertEq(uint256(Status.REVOKED), _uint(".enums.Status.REVOKED"));
        assertEq(uint256(Status.EXECUTED), _uint(".enums.Status.EXECUTED"));

        assertEq(uint256(VerificationMethod.OOB_KNOWN_CONTACT), _uint(".enums.VerificationMethod.OOB_KNOWN_CONTACT"));
        assertEq(uint256(VerificationMethod.PSP_ATTESTATION), _uint(".enums.VerificationMethod.PSP_ATTESTATION"));

        assertEq(uint256(VerificationResult.CONFIRMED), _uint(".enums.VerificationResult.CONFIRMED"));
        assertEq(uint256(VerificationResult.DENIED), _uint(".enums.VerificationResult.DENIED"));

        assertEq(uint256(RevocationReason.SUPPLIER_DENIED), _uint(".enums.RevocationReason.SUPPLIER_DENIED"));
        assertEq(uint256(RevocationReason.ANALYST_DECISION), _uint(".enums.RevocationReason.ANALYST_DECISION"));
        assertEq(uint256(RevocationReason.KILL_SWITCH), _uint(".enums.RevocationReason.KILL_SWITCH"));
        assertEq(uint256(RevocationReason.EXPIRED), _uint(".enums.RevocationReason.EXPIRED"));
    }

    // ------------------------------------------------------------------ domain

    function test_DomainSeparator_MatchesTheVector() public view {
        assertEq(_vectorDomainSeparator(), _bytes32(".domainSeparator"), "domain separator of the vector");
    }

    function test_RegistryDomain_HasTheVectorNameAndVersionAndFollowsTheSameFormula() public view {
        (, string memory name, string memory version, uint256 chainId, address verifyingContract,,) =
            registry.eip712Domain();

        assertEq(name, _string(".domain.name"), "domain name");
        assertEq(version, _string(".domain.version"), "domain version");
        assertEq(chainId, vm.getChainId(), "domain chain id");
        assertEq(verifyingContract, address(registry), "domain verifying contract");
        assertEq(
            registry.domainSeparator(),
            _domainSeparatorFor(name, version, chainId, verifyingContract),
            "the registry builds its separator with the formula checked against the vector"
        );
    }

    // ------------------------------------------------------------------ the three messages

    function test_PaymentIntent_MatchesTheVector() public view {
        PaymentIntent memory i = _vectorIntent();
        bytes32 structHash = registry.hashIntent(i);

        assertEq(structHash, _bytes32(".vectors.PaymentIntent.structHash"), "PaymentIntent struct hash");
        assertEq(
            _digest(_vectorDomainSeparator(), structHash),
            _bytes32(".vectors.PaymentIntent.digest"),
            "PaymentIntent digest"
        );
        // The registry builds the digest it stores (the intent hash) the same way, with its own domain.
        assertEq(registry.digestOf(i), _digest(registry.domainSeparator(), structHash), "registry digest");
    }

    function test_VerificationAttestation_MatchesTheVector() public view {
        bytes32 structHash = registry.hashVerification(_vectorAttestation());

        assertEq(
            structHash, _bytes32(".vectors.VerificationAttestation.structHash"), "VerificationAttestation struct hash"
        );
        assertEq(
            _digest(_vectorDomainSeparator(), structHash),
            _bytes32(".vectors.VerificationAttestation.digest"),
            "VerificationAttestation digest"
        );
    }

    function test_Revocation_MatchesTheVector() public view {
        bytes32 structHash = registry.hashRevocation(_vectorRevocation());

        assertEq(structHash, _bytes32(".vectors.Revocation.structHash"), "Revocation struct hash");
        assertEq(
            _digest(_vectorDomainSeparator(), structHash), _bytes32(".vectors.Revocation.digest"), "Revocation digest"
        );
    }

    // ------------------------------------------------------------------ reading the vector

    function _vectorIntent() internal view returns (PaymentIntent memory) {
        string memory m = ".vectors.PaymentIntent.message";
        return PaymentIntent({
            paymentId: _bytes32(string.concat(m, ".paymentId")),
            corridorId: _bytes32(string.concat(m, ".corridorId")),
            beneficiary: _address(string.concat(m, ".beneficiary")),
            token: _address(string.concat(m, ".token")),
            amount: _uint(string.concat(m, ".amount")),
            offchainHash: _bytes32(string.concat(m, ".offchainHash")),
            decisionHash: _bytes32(string.concat(m, ".decisionHash")),
            approvalHash: _bytes32(string.concat(m, ".approvalHash")),
            tier: SafeCast.toUint8(_uint(string.concat(m, ".tier"))),
            validUntil: SafeCast.toUint64(_uint(string.concat(m, ".validUntil"))),
            nonce: _uint(string.concat(m, ".nonce"))
        });
    }

    function _vectorAttestation() internal view returns (VerificationAttestation memory) {
        string memory m = ".vectors.VerificationAttestation.message";
        return VerificationAttestation({
            paymentId: _bytes32(string.concat(m, ".paymentId")),
            intentHash: _bytes32(string.concat(m, ".intentHash")),
            method: SafeCast.toUint8(_uint(string.concat(m, ".method"))),
            result: SafeCast.toUint8(_uint(string.concat(m, ".result"))),
            simSwapChecked: vm.parseJsonBool(json, string.concat(m, ".simSwapChecked")),
            evidenceHash: _bytes32(string.concat(m, ".evidenceHash")),
            verifiedAt: SafeCast.toUint64(_uint(string.concat(m, ".verifiedAt"))),
            nonce: _uint(string.concat(m, ".nonce"))
        });
    }

    function _vectorRevocation() internal view returns (Revocation memory) {
        string memory m = ".vectors.Revocation.message";
        return Revocation({
            paymentId: _bytes32(string.concat(m, ".paymentId")),
            reasonCode: SafeCast.toUint8(_uint(string.concat(m, ".reasonCode"))),
            caseHash: _bytes32(string.concat(m, ".caseHash")),
            nonce: _uint(string.concat(m, ".nonce"))
        });
    }

    /// @dev The domain separator of the vector, built from its `domain` fields.
    function _vectorDomainSeparator() internal view returns (bytes32) {
        return _domainSeparatorFor(
            _string(".domain.name"),
            _string(".domain.version"),
            _uint(".domain.chainId"),
            _address(".domain.verifyingContract")
        );
    }

    /// @dev EIP-712 `hashStruct(EIP712Domain)` for a domain with name, version, chainId and verifyingContract.
    function _domainSeparatorFor(string memory name, string memory version, uint256 chainId, address verifyingContract)
        internal
        pure
        returns (bytes32)
    {
        return keccak256(
            abi.encode(
                EIP712_DOMAIN_TYPEHASH, keccak256(bytes(name)), keccak256(bytes(version)), chainId, verifyingContract
            )
        );
    }

    /// @dev EIP-712 digest: keccak256(0x1901 ‖ domainSeparator ‖ structHash).
    function _digest(bytes32 separator, bytes32 structHash) internal pure returns (bytes32) {
        return keccak256(abi.encodePacked("\x19\x01", separator, structHash));
    }

    // Uint values are decimal strings in the file ("85000000000"): `parseJsonUint` converts them.
    function _uint(string memory path) internal view returns (uint256) {
        return vm.parseJsonUint(json, path);
    }

    function _bytes32(string memory path) internal view returns (bytes32) {
        return vm.parseJsonBytes32(json, path);
    }

    function _address(string memory path) internal view returns (address) {
        return vm.parseJsonAddress(json, path);
    }

    function _string(string memory path) internal view returns (string memory) {
        return vm.parseJsonString(json, path);
    }
}
