pragma solidity ^0.8.28;

import {Test} from "forge-std/Test.sol";

import {PaymentRegistry} from "../src/PaymentRegistry.sol";
import {
    PAYMENT_INTENT_TYPEHASH,
    REVOCATION_TYPEHASH,
    VERIFICATION_ATTESTATION_TYPEHASH,
    PaymentIntent,
    Revocation,
    VerificationAttestation
} from "../src/SyloTypes.sol";

/// @notice The shared vector in spec/eip712.json (generated by sylo_spec.eip712) must hash identically here,
/// so an intent signed by the Python engine is the intent the contracts verify.
contract Eip712VectorTest is Test {
    bytes32 private constant DOMAIN_TYPEHASH =
        keccak256("EIP712Domain(string name,string version,uint256 chainId,address verifyingContract)");

    string private json;
    PaymentRegistry private registry;

    function setUp() public {
        json = vm.readFile(string.concat(vm.projectRoot(), "/../spec/eip712.json"));
        registry = new PaymentRegistry(address(this));
    }

    function test_DomainSeparator() public view {
        assertEq(vm.parseJsonString(json, ".domain.name"), "SyloPaymentRegistry");
        assertEq(vm.parseJsonString(json, ".domain.version"), "1");
        assertEq(_vectorDomainSeparator(), vm.parseJsonBytes32(json, ".domain.separator"));
    }

    function test_RegistryUsesTheStandardDomain() public view {
        bytes32 expected = _domainSeparator("SyloPaymentRegistry", "1", block.chainid, address(registry));
        assertEq(registry.domainSeparator(), expected);
    }

    function test_TypeHashes() public view {
        _assertTypeHash("PaymentIntent", PAYMENT_INTENT_TYPEHASH);
        _assertTypeHash("VerificationAttestation", VERIFICATION_ATTESTATION_TYPEHASH);
        _assertTypeHash("Revocation", REVOCATION_TYPEHASH);
    }

    function test_PaymentIntentVector() public view {
        string memory m = ".vectors.PaymentIntent.message";
        PaymentIntent memory i;
        i.paymentId = vm.parseJsonBytes32(json, string.concat(m, ".paymentId"));
        i.corridorId = vm.parseJsonBytes32(json, string.concat(m, ".corridorId"));
        i.beneficiary = vm.parseJsonAddress(json, string.concat(m, ".beneficiary"));
        i.token = vm.parseJsonAddress(json, string.concat(m, ".token"));
        i.amount = vm.parseJsonUint(json, string.concat(m, ".amount"));
        i.offchainHash = vm.parseJsonBytes32(json, string.concat(m, ".offchainHash"));
        i.decisionHash = vm.parseJsonBytes32(json, string.concat(m, ".decisionHash"));
        i.approvalHash = vm.parseJsonBytes32(json, string.concat(m, ".approvalHash"));
        i.tier = uint8(vm.parseJsonUint(json, string.concat(m, ".tier")));
        i.validUntil = uint64(vm.parseJsonUint(json, string.concat(m, ".validUntil")));
        i.nonce = vm.parseJsonUint(json, string.concat(m, ".nonce"));

        _assertVector("PaymentIntent", registry.hashIntent(i));
        bytes32 local = keccak256(abi.encodePacked("\x19\x01", registry.domainSeparator(), registry.hashIntent(i)));
        assertEq(registry.digestOf(i), local, "digestOf must be the EIP-712 digest under the registry's domain");
    }

    function test_VerificationAttestationVector() public view {
        string memory m = ".vectors.VerificationAttestation.message";
        VerificationAttestation memory v;
        v.paymentId = vm.parseJsonBytes32(json, string.concat(m, ".paymentId"));
        v.intentHash = vm.parseJsonBytes32(json, string.concat(m, ".intentHash"));
        v.method = uint8(vm.parseJsonUint(json, string.concat(m, ".method")));
        v.result = uint8(vm.parseJsonUint(json, string.concat(m, ".result")));
        v.simSwapChecked = vm.parseJsonBool(json, string.concat(m, ".simSwapChecked"));
        v.evidenceHash = vm.parseJsonBytes32(json, string.concat(m, ".evidenceHash"));
        v.verifiedAt = uint64(vm.parseJsonUint(json, string.concat(m, ".verifiedAt")));
        v.nonce = vm.parseJsonUint(json, string.concat(m, ".nonce"));

        _assertVector("VerificationAttestation", registry.hashVerification(v));
        assertEq(v.intentHash, vm.parseJsonBytes32(json, ".vectors.PaymentIntent.digest"), "attestation must cite the intent digest");
    }

    function test_RevocationVector() public view {
        string memory m = ".vectors.Revocation.message";
        Revocation memory r;
        r.paymentId = vm.parseJsonBytes32(json, string.concat(m, ".paymentId"));
        r.reasonCode = uint8(vm.parseJsonUint(json, string.concat(m, ".reasonCode")));
        r.caseHash = vm.parseJsonBytes32(json, string.concat(m, ".caseHash"));
        r.nonce = vm.parseJsonUint(json, string.concat(m, ".nonce"));

        _assertVector("Revocation", registry.hashRevocation(r));
    }

    function _assertVector(string memory name, bytes32 structHash) private view {
        string memory base = string.concat(".vectors.", name);
        assertEq(structHash, vm.parseJsonBytes32(json, string.concat(base, ".structHash")), "structHash");
        bytes32 digest = keccak256(abi.encodePacked("\x19\x01", _vectorDomainSeparator(), structHash));
        assertEq(digest, vm.parseJsonBytes32(json, string.concat(base, ".digest")), "digest");
    }

    function _assertTypeHash(string memory name, bytes32 constantValue) private view {
        string memory typeString = vm.parseJsonString(json, string.concat(".types.", name));
        assertEq(keccak256(bytes(typeString)), constantValue, "type string");
        assertEq(vm.parseJsonBytes32(json, string.concat(".typehashes.", name)), constantValue, "typehash");
    }

    function _vectorDomainSeparator() private view returns (bytes32) {
        return _domainSeparator(
            vm.parseJsonString(json, ".domain.name"),
            vm.parseJsonString(json, ".domain.version"),
            vm.parseJsonUint(json, ".domain.chainId"),
            vm.parseJsonAddress(json, ".domain.verifyingContract")
        );
    }

    function _domainSeparator(string memory name, string memory version, uint256 chainId, address verifyingContract)
        private
        pure
        returns (bytes32)
    {
        return keccak256(
            abi.encode(DOMAIN_TYPEHASH, keccak256(bytes(name)), keccak256(bytes(version)), chainId, verifyingContract)
        );
    }
}
