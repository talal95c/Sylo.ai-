# Copy to .env (git-ignored) and fill in. Never commit .env.
# Owners: see docs/setup.md section 8.

# --- Engine (Lane A) ---
RISK_MODE=rules            # rules | model
CHAIN_MODE=mock            # mock | fuji
LLM_MODE=off               # off | cached | live   (needs Lane B's case writer; otherwise the case file comes from the rules)
LIVE_INVOICE=off           # on: enable the Live-only jury invoice flow (also needs MISTRAL_API_KEY and JEV_API_KEY)
TELECOM_MODE=mock          # mock | orange-playground (Orange Playground uses sandbox data)
ORANGE_CLIENT_ID=
ORANGE_CLIENT_SECRET=
DEMO_SPEED=1
DEMO_PUBLIC=0              # 1 on a shared public URL: approvals, case actions, guardian, payee checks, sim and breaker endpoints answer 403
HUMAN_STEPS=auto           # auto: payer approvals and analyst are simulated | manual: wait for them on the API (v1 panels)
JOURNAL_PATH=              # decision log; default engine/data/log.jsonl, "off" disables it
CORS_ORIGINS=               # comma-separated origins for local or split web/engine setups
TIME_LOCK_FROM_EUR=5000    # first payment to a new account, bank hold: 4 h from this amount (TIME_LOCK_HOURS)
TIME_LOCK_LONG_FROM_EUR=50000  # ... and 24 h above this one (TIME_LOCK_LONG_HOURS)
REROUTE_MAX_FEES_EUR=500   # a replacement route is used without asking the payer only up to these fees
REROUTE_MAX_DAYS=3         # ... and this delay
CONFIDENTIAL_MODE=off      # off | simulated | eerc: chain leg of a payment that needs no hold as an eERC confidential transfer
EERC_URL=http://127.0.0.1:8010  # Lane C's service (cd chain/eerc && node src/server.mjs), used when CONFIDENTIAL_MODE=eerc
CLUSTER_MODE=auto          # auto: Lane B's mule-cluster detector when installed, else the sample | sample: always the sample
MISTRAL_API_KEY=           # Lane B (case writer)
JEV_MODE=
JEV_API_KEY=
JEV_BASE_URL=
JEV_MODEL=

# --- Chain (Lane C, v1) ---
FUJI_RPC_URL=https://api.avax-test.network/ext/bc/C/rpc
FUJI_RPC_URL_2=https://avalanche-fuji-c-chain-rpc.publicnode.com
CHAIN_ID=43113
EXPLORER_BASE_URL=https://testnet.snowtrace.io
REGISTRY_ADDRESS=
ESCROW_ADDRESS=
TOKEN_ADDRESS=
DEPLOYER_PK=
RELAYER_PK=
ROUTER_SIGNER_PK=
VERIFIER_SIGNER_PK=
ANALYST_SIGNER_PK=
GUARDIAN_PK=
EU_CASP_PK=
GH_VASP_PK=                # eERC only (v2)
ATTACKER_PK=
# Public addresses of the roles (read by Deploy.s.sol and the engine)
RELAYER_ADDRESS=
ROUTER_SIGNER_ADDRESS=
VERIFIER_SIGNER_ADDRESS=
ANALYST_SIGNER_ADDRESS=
GUARDIAN_ADDRESS=
EU_CASP_ADDRESS=
GH_VASP_ADDRESS=

# --- Web (Lane D) ---
NEXT_PUBLIC_ENGINE_URL=http://localhost:8000
NEXT_PUBLIC_SOURCE=live    # live | replay
NEXT_PUBLIC_ENGINE_CONNECT_TIMEOUT_MS=2000 # Browser timeout before switching to replay
